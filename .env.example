# Data Detective AI Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Backend Environment
PORT=8000
ENVIRONMENT=development

# Storage Configuration
# 'local' → stores files in LOCAL_STORAGE_DIR (default for development)
# 's3'    → stores files in Amazon S3 (requires S3_BUCKET_NAME)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# ──────────────────────────────────────────────────────────────────────────────
# Phase 2D — AWS Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Credentials are resolved via boto3 standard credential chain:
#   - AWS_PROFILE: uses a named profile from ~/.aws/credentials (recommended for local dev)
#   - Or: environment provides, IAM role when deployed to AWS
#
# NEVER put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Run: aws configure --profile data-detective  (to set up local profile)

AWS_REGION=ap-south-1
AWS_PROFILE=data-detective

# S3 bucket (must already exist — do not auto-create from application code)
S3_BUCKET_NAME=

# S3 prefixes (defaults work with existing bucket layout)
S3_RAW_PREFIX=raw/
S3_CURATED_PREFIX=curated/
S3_ATHENA_RESULTS_PREFIX=athena-results/

# Glue Data Catalog + Athena
ATHENA_DATABASE=data_detective
ATHENA_WORKGROUP=data-detective
# Athena output location (leave empty to auto-derive from S3_BUCKET_NAME)
ATHENA_OUTPUT_LOCATION=

# ──────────────────────────────────────────────────────────────────────────────

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Settings (Phase 2B / Phase 2C) — Required for AI Intelligence & Code Generator
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SQL_DIALECT=generic
