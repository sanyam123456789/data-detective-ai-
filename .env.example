# Data Detective AI Environment Configuration

# Backend Environment
PORT=8000
ENVIRONMENT=development

# Storage Configuration
# Set to 's3' to upload to Amazon S3, or 'local' to use local folder storage fallback.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# AWS Credentials (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=data-detective-ai-uploads

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Settings (Phase 2B / Phase 2C) — Required for AI Intelligence & Code Generator
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SQL_DIALECT=generic
